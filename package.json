{
  "name": "local-transcribe",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "transcribe": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && biome check src test scripts",
    "test": "bun test && python3 -m unittest discover -s python_tests -v",
    "start": "bun src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "build:native": "bun scripts/build-release.ts"
  },
  "dependencies": {
    "commander": "14.0.0",
    "effect": "4.0.6",
    "opencc-js": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  }
}
